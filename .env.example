# Server Configuration
PORT=3000
SESSION_SECRET=digital_memory_vault_secure_session_secret_key_phase1

# Backend Public HTTPS URL (Required for Google OAuth on Mobile & Production)
# e.g. https://vault.example.com or your public tunnel URL
BACKEND_URL=https://YOUR_PUBLIC_BACKEND_DOMAIN

# Google OAuth 2.0 Credentials
# Obtain these credentials from the Google Cloud Console (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# Google Redirect URI (Auto-derived from BACKEND_URL if left blank, or set explicitly)
# Local Development: http://localhost:3000/api/auth/google/callback
# Production / Mobile: https://YOUR_PUBLIC_BACKEND_DOMAIN/api/auth/google/callback
GOOGLE_REDIRECT_URI=https://YOUR_PUBLIC_BACKEND_DOMAIN/api/auth/google/callback
